# Track 4 — E2E round 1: 10 vCPU total budget
#
# | Service              | cpus x replicas | subtotal |
# |----------------------|-----------------|----------|
# | Redis x 3            | 0.2 x 3         | 0.6      |
# | request-handler      | 0.5 x 2         | 1.0      |
# | verifier-selector    | 0.4 x 1         | 0.4      |
# | token-issuer         | 0.5 x 2         | 1.0      |
# | snark-verifier       | 1.0 x 5         | 5.0      |
# | token-validator (x5) | 0.4 x 5         | 2.0      |
# | TOTAL                |                 | 10.0     |
#
# Load with:  set -a; source e2e-throughput-round1.env; set +a
REDIS_CPUS=0.2
HANDLER_REPLICAS=2
HANDLER_CPUS=0.5
SELECTOR_CPUS=0.4
ISSUER_REPLICAS=2
ISSUER_CPUS=0.5
SNARK_REPLICAS=5
SNARK_COUNT=5
# Applied manually on each App EC2: docker update --cpus=$VALIDATOR_CPUS ...
VALIDATOR_CPUS=0.4

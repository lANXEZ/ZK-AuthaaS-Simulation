FROM python:3.11-slim

WORKDIR /app

COPY TokenIssuanceModule.py .

# pyjwt[crypto] pulls in `cryptography` which handles RS256 natively.
# No gcc needed — pre-built manylinux wheels are available for linux/amd64.
RUN pip install --no-cache-dir \
    redis==5.0.4 \
    pyjwt[crypto]==2.8.0 \
    requests==2.31.0

ENTRYPOINT ["python", "TokenIssuanceModule.py"]
